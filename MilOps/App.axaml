<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MilOps"
             xmlns:converters="using:MilOps.Converters"
             xmlns:svg="using:Avalonia.Svg.Skia"
             x:Class="MilOps.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- Material Icons 스타일 -->
        <Style Selector="TextBlock.mi">
            <Setter Property="FontFamily" Value="avares://MilOps/Assets/Fonts/MaterialIcons-Regular.ttf#Material Icons"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <!-- 글로벌 버튼 스타일 (iOS 스타일 둥근 모서리) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#00a872"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#488e72"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#E5E5EA"/>
            <Setter Property="Foreground" Value="#1C1C1E"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D1D1D6"/>
        </Style>

        <!-- 카드 스타일 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- 입력 필드 스타일 -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#E5E5EA"/>
            <Setter Property="Foreground" Value="#1C1C1E"/>
            <Setter Property="BorderBrush" Value="#C7C7CC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#00a872"/>
        </Style>

        <!-- 콤보박스 스타일 -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#E5E5EA"/>
            <Setter Property="Foreground" Value="#1C1C1E"/>
            <Setter Property="BorderBrush" Value="#C7C7CC"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <!-- 앱 색상 팔레트 -->
        <Color x:Key="PrimaryColor">#00a872</Color>
        <Color x:Key="PrimaryDarkColor">#488e72</Color>
        <Color x:Key="AccentLightColor">#1C1C1E</Color>
        <Color x:Key="AccentWarmColor">#deb887</Color>

        <!-- 라이트모드 배경 색상 -->
        <Color x:Key="BgPrimaryColor">#F2F2F7</Color>
        <Color x:Key="BgSecondaryColor">#FFFFFF</Color>
        <Color x:Key="BgTertiaryColor">#E5E5EA</Color>
        <Color x:Key="BorderColor">#C7C7CC</Color>

        <!-- 텍스트 색상 -->
        <Color x:Key="TextPrimaryColor">#1C1C1E</Color>
        <Color x:Key="TextSecondaryColor">#8E8E93</Color>
        <Color x:Key="TextMutedColor">#AEAEB2</Color>

        <!-- SolidColorBrush 리소스 -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#00a872"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#488e72"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="AccentWarmBrush" Color="#deb887"/>
        <SolidColorBrush x:Key="BgPrimaryBrush" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="BgSecondaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgTertiaryBrush" Color="#E5E5EA"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#C7C7CC"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93"/>

        <!-- Material Icons 폰트 리소스 -->
        <FontFamily x:Key="MaterialIcons">avares://MilOps/Assets/Fonts/MaterialIcons-Regular.ttf#Material Icons</FontFamily>

        <!-- 31사단 마크 SVG -->
        <svg:SvgImage x:Key="Mark31Svg" Source="avares://MilOps/Assets/31_mark.svg"/>
        <converters:StatusFilterConverter x:Key="StatusFilterConverter"/>
        <converters:BoolToTabBgConverter x:Key="BoolToTabBgConverter"/>
        <converters:BoolToTabFgConverter x:Key="BoolToTabFgConverter"/>
        <converters:BoolToSlotBgConverter x:Key="BoolToSlotBgConverter"/>
        <converters:BoolToSlotBorderConverter x:Key="BoolToSlotBorderConverter"/>
        <converters:BoolToSlotFgConverter x:Key="BoolToSlotFgConverter"/>
        <converters:BoolToDateBgConverter x:Key="BoolToDateBgConverter"/>
        <converters:BoolToDateFgConverter x:Key="BoolToDateFgConverter"/>
        <converters:BoolToSaveBtnColorConverter x:Key="BoolToSaveBtnColorConverter"/>
        <converters:BoolToSaveBtnTextConverter x:Key="BoolToSaveBtnTextConverter"/>
        <converters:BoolToFilterBgConverter x:Key="BoolToFilterBgConverter"/>
        <converters:BoolToFilterFgConverter x:Key="BoolToFilterFgConverter"/>
    </Application.Resources>
</Application>