<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilOps.ViewModels"
             xmlns:controls="using:MilOps.Views.Controls"
             xmlns:converters="using:MilOps.Converters"
             x:Class="MilOps.Views.ManagerView"
             x:DataType="vm:ManagerViewModel">

  <Grid Background="#F2F2F7" RowDefinitions="Auto,*">
    <!-- Row 0: 헤더 + 필터 (고정, 스크롤 안 됨) -->
    <StackPanel Grid.Row="0" Margin="10,10,10,0" Spacing="10">
      <!-- 헤더 -->
      <TextBlock Text="{Binding HeaderTitle}" FontSize="18"
                 Foreground="#1C1C1E" Margin="4,4,0,0"/>

      <!-- 필터 탭 -->
      <Border Background="#FFFFFF" CornerRadius="10" Padding="4">
        <Grid ColumnDefinitions="*,*,*">
          <Button Grid.Column="0" Command="{Binding SetFilterAllCommand}"
                  Background="{Binding FilterType, Converter={StaticResource StatusFilterConverter}, ConverterParameter=all}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  CornerRadius="8" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Text="전체" FontSize="13" Foreground="#1C1C1E" VerticalAlignment="Center"/>
              <Border Background="#E5E5EA" CornerRadius="8" Padding="6,2" MinWidth="22">
                <TextBlock Text="{Binding TotalCount}" FontSize="11" Foreground="#8E8E93"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Command="{Binding SetFilterLocalCommand}"
                  Background="{Binding FilterType, Converter={StaticResource StatusFilterConverter}, ConverterParameter=local}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  CornerRadius="8" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Text="행정" FontSize="13" Foreground="#1C1C1E" VerticalAlignment="Center"/>
              <Border Background="#E5E5EA" CornerRadius="8" Padding="6,2" MinWidth="22">
                <TextBlock Text="{Binding LocalCount}" FontSize="11" Foreground="#8E8E93"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Command="{Binding SetFilterMilitaryCommand}"
                  Background="{Binding FilterType, Converter={StaticResource StatusFilterConverter}, ConverterParameter=military}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  CornerRadius="8" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Text="군" FontSize="13" Foreground="#1C1C1E" VerticalAlignment="Center"/>
              <Border Background="#E5E5EA" CornerRadius="8" Padding="6,2" MinWidth="22">
                <TextBlock Text="{Binding MilitaryCount}" FontSize="11" Foreground="#8E8E93"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Row 1: 유저 목록 (가상화 ListBox — 화면에 보이는 아이템만 렌더링) -->
    <ListBox x:Name="UserListBox" Grid.Row="1" ItemsSource="{Binding Users}"
             Background="Transparent" Margin="10,10,10,10"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.Styles>
        <!-- ListBoxItem 기본 스타일 완전 제거 -->
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0,0,0,6"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Focusable" Value="False"/>
          <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <!-- ListBoxItem 모든 상태에서 배경/외곽선 제거 -->
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:focus">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <!-- ListBoxItem 내부 템플릿 Border 제거 -->
        <Style Selector="ListBoxItem /template/ Border#PART_LayoutRoot">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ Border#PART_LayoutRoot">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:focus /template/ Border#PART_LayoutRoot">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Button 외곽선 완전 제거 (모든 상태) -->
        <Style Selector="ListBoxItem Button">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem Button:focus">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem Button:pressed">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem Button:disabled">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- Button 내부 템플릿 Border 제거 -->
        <Style Selector="ListBoxItem Button /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:UserListItem">
          <Button Command="{Binding $parent[ListBox].((vm:ManagerViewModel)DataContext).SelectUserCommand}"
                  CommandParameter="{Binding}"
                  IsEnabled="{Binding $parent[ListBox].((vm:ManagerViewModel)DataContext).CanStartChat}"
                  Background="Transparent" Padding="0"
                  BorderThickness="0" BorderBrush="Transparent"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
            <Border Background="#FFFFFF" CornerRadius="10" Padding="14">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- 역할 아이콘 -->
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                        Background="{Binding RoleColor}" Margin="0,0,12,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding RoleIcon}" FontSize="14"
                             Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 정보 -->
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#1C1C1E"/>
                    <TextBlock Text="{Binding RoleDisplayName}" FontSize="11" Foreground="#8E8E93"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>

                <!-- 채팅 아이콘 (채팅 가능한 역할만 표시) -->
                <Border Grid.Column="2" VerticalAlignment="Center"
                        IsVisible="{Binding $parent[ListBox].((vm:ManagerViewModel)DataContext).CanStartChat}">
                  <TextBlock Text="&#xe0c9;" FontFamily="{StaticResource MaterialIcons}"
                             FontSize="22" Foreground="#007AFF"/>
                </Border>
              </Grid>
            </Border>
          </Button>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- 빈 상태 (ListBox 위에 오버레이) -->
    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" Padding="30" Margin="10"
            IsVisible="{Binding !Users.Count}"
            VerticalAlignment="Top">
      <StackPanel HorizontalAlignment="Center" Spacing="8">
        <TextBlock Text="&#xe7fb;" FontFamily="{StaticResource MaterialIcons}"
                   FontSize="36" Foreground="#C7C7CC" HorizontalAlignment="Center"/>
        <TextBlock Text="담당자가 없습니다" FontSize="14" Foreground="#8E8E93" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- 에러 메시지 -->
    <Border Grid.Row="1" Background="#FFF3F3" CornerRadius="8" Padding="12" Margin="10"
            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            VerticalAlignment="Bottom">
      <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="#FF3B30"
                 TextWrapping="Wrap"/>
    </Border>

    <!-- 워터마크 (최상단 레이어, IsHitTestVisible=False로 터치 통과) -->
    <Image Grid.RowSpan="2" Source="{StaticResource Mark31WatermarkSvg}"
           Width="240" Height="280" 
           HorizontalAlignment="Center" VerticalAlignment="Center"
           IsHitTestVisible="False"/>

    <!-- 로딩 오버레이 -->
    <controls:LoadingOverlay Grid.RowSpan="2" IsVisible="{Binding IsLoading}"/>
  </Grid>
</UserControl>
