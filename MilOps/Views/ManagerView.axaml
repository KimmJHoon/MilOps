<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilOps.ViewModels"
             xmlns:controls="using:MilOps.Views.Controls"
             x:Class="MilOps.Views.ManagerView"
             x:DataType="vm:ManagerViewModel">

  <Grid Background="#F2F2F7">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="10" Spacing="10">

        <!-- 헤더 -->
        <TextBlock Text="{Binding HeaderTitle}" FontSize="18"
                   Foreground="#1C1C1E" Margin="4,4,0,0"/>

        <!-- 통계 카드 -->
        <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,4">
          <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="12" Margin="0,0,4,0">
            <StackPanel HorizontalAlignment="Center" Spacing="4">
              <TextBlock Text="{Binding TotalCount}" FontSize="22"
                         Foreground="#1C1C1E" HorizontalAlignment="Center"/>
              <TextBlock Text="전체" FontSize="12" Foreground="#8E8E93" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10" Padding="12" Margin="2,0,2,0">
            <StackPanel HorizontalAlignment="Center" Spacing="4">
              <TextBlock Text="{Binding LocalCount}" FontSize="22"
                         Foreground="#007AFF" HorizontalAlignment="Center"/>
              <TextBlock Text="행정" FontSize="12" Foreground="#8E8E93" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" Padding="12" Margin="4,0,0,0">
            <StackPanel HorizontalAlignment="Center" Spacing="4">
              <TextBlock Text="{Binding MilitaryCount}" FontSize="22"
                         Foreground="#34C759" HorizontalAlignment="Center"/>
              <TextBlock Text="군" FontSize="12" Foreground="#8E8E93" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- 필터 탭 -->
        <Border Background="#FFFFFF" CornerRadius="10" Padding="4">
          <Grid ColumnDefinitions="*,*,*">
            <Button Grid.Column="0" Command="{Binding SetFilterAllCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    CornerRadius="8" Padding="8,6"
                    Background="{Binding FilterType, Converter={x:Static StringConverters.IsNotNullOrEmpty}, ConverterParameter=all}"
                    Classes="filterTab">
              <Button.Background>
                <MultiBinding>
                  <Binding Path="FilterType"/>
                </MultiBinding>
              </Button.Background>
              <TextBlock Text="전체" FontSize="13" HorizontalAlignment="Center"
                         Foreground="{Binding FilterType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </Button>
            <Button Grid.Column="1" Command="{Binding SetFilterLocalCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    CornerRadius="8" Padding="8,6">
              <TextBlock Text="행정" FontSize="13" HorizontalAlignment="Center"/>
            </Button>
            <Button Grid.Column="2" Command="{Binding SetFilterMilitaryCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    CornerRadius="8" Padding="8,6">
              <TextBlock Text="군" FontSize="13" HorizontalAlignment="Center"/>
            </Button>
          </Grid>
        </Border>

        <!-- 유저 목록 -->
        <ItemsControl ItemsSource="{Binding Users}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:UserListItem">
              <Border Background="#FFFFFF" CornerRadius="10" Padding="14" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*">
                  <!-- 역할 아이콘 -->
                  <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                          Background="{Binding RoleColor}" Margin="0,0,12,0"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding RoleIcon}" FontSize="14"
                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>

                  <!-- 정보 -->
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#1C1C1E"/>
                      <TextBlock Text="{Binding RoleDisplayName}" FontSize="11" Foreground="#8E8E93"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Affiliation}" FontSize="12" Foreground="#AEAEB2"
                               IsVisible="{Binding Affiliation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 빈 상태 -->
        <Border Background="#FFFFFF" CornerRadius="10" Padding="30"
                IsVisible="{Binding !Users.Count}">
          <StackPanel HorizontalAlignment="Center" Spacing="8">
            <TextBlock Text="&#xe7fb;" FontFamily="{StaticResource MaterialIcons}"
                       FontSize="36" Foreground="#C7C7CC" HorizontalAlignment="Center"/>
            <TextBlock Text="담당자가 없습니다" FontSize="14" Foreground="#8E8E93" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- 에러 메시지 -->
        <Border Background="#FFF3F3" CornerRadius="8" Padding="12"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="#FF3B30"
                     TextWrapping="Wrap"/>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- 로딩 오버레이 -->
    <controls:LoadingOverlay IsVisible="{Binding IsLoading}"/>
  </Grid>
</UserControl>
