<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilOps.ViewModels"
             x:Class="MilOps.Views.ScheduleCreateView"
             x:DataType="vm:ScheduleCreateViewModel"
             DataContext="{x:Null}">

  <Grid Background="#F2F2F7">
    <!-- 권한 없음 메시지 -->
    <Border IsVisible="{Binding !HasPermission}"
            Background="#FFFFFF" CornerRadius="12" Padding="20"
            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
      <StackPanel Spacing="10" HorizontalAlignment="Center">
        <TextBlock Text="권한 없음" FontSize="18" Foreground="#F44336" HorizontalAlignment="Center"/>
        <TextBlock Text="일정 생성은 사단담당자만 가능합니다." FontSize="13" Foreground="#8E8E93"
                   TextWrapping="Wrap" HorizontalAlignment="Center"/>
        <Button Command="{Binding CloseCommand}" Background="#C7C7CC" Padding="20,10" CornerRadius="10"
                HorizontalAlignment="Center" Margin="0,10,0,0">
          <TextBlock Text="닫기" Foreground="#1C1C1E" FontSize="13"/>
        </Button>
      </StackPanel>
    </Border>

    <!-- 메인 컨텐츠 -->
    <Grid IsVisible="{Binding HasPermission}" RowDefinitions="Auto,*">
      <!-- 헤더 -->
      <Border Grid.Row="0" Background="#FFFFFF" Padding="14">
        <Grid ColumnDefinitions="Auto,*">
          <Button Grid.Column="0" Command="{Binding CloseCommand}"
                  Background="Transparent" Padding="8,4">
            <TextBlock Text="뒤로" Foreground="#1C1C1E" FontSize="14"/>
          </Button>
          <TextBlock Grid.Column="1" Text="일정 생성" FontSize="16" Foreground="#1C1C1E"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- 폼 컨텐츠 -->
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" Spacing="16">
          <!-- 현재 사용자 정보 -->
          <Border Background="#FFFFFF" CornerRadius="12" Padding="14">
            <TextBlock Text="{Binding CurrentUserDisplay}" FontSize="13" Foreground="#1C1C1E"
                       HorizontalAlignment="Center"/>
          </Border>

          <!-- 로딩 -->
          <TextBlock Text="로딩중..." IsVisible="{Binding IsLoading}"
                     Foreground="#8E8E93" HorizontalAlignment="Center" FontSize="13"/>

          <!-- 성공 메시지 -->
          <Border Background="#E8F5E9" CornerRadius="12" Padding="12"
                  IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="#00a872" FontSize="13"
                       HorizontalAlignment="Center"/>
          </Border>

          <!-- 에러 메시지 -->
          <Border Background="#FFEAEE" CornerRadius="12" Padding="12"
                  IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#F44336" FontSize="13"
                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
          </Border>

          <!-- 새 일정 생성 섹션 -->
          <Border Background="#FFFFFF" CornerRadius="12" Padding="16">
            <StackPanel Spacing="14">
              <TextBlock Text="새 일정 생성" FontSize="15" Foreground="#1C1C1E"/>

              <!-- 지자체 (시/도) -->
              <StackPanel Spacing="6">
                <TextBlock Text="지자체 (시/도)" Foreground="#8E8E93" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Regions}"
                          SelectedItem="{Binding SelectedRegion}"
                          Background="#E5E5EA"
                          Foreground="#1C1C1E"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="시/도 선택"
                          CornerRadius="8">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- 지자체 (구/군) -->
              <StackPanel Spacing="6">
                <TextBlock Text="지자체 (구/군)" Foreground="#8E8E93" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Districts}"
                          SelectedItem="{Binding SelectedDistrict}"
                          Background="#E5E5EA"
                          Foreground="#1C1C1E"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="구/군 선택"
                          CornerRadius="8"
                          IsEnabled="{Binding SelectedRegion, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- 담당대대 -->
              <StackPanel Spacing="6">
                <TextBlock Text="담당대대" Foreground="#8E8E93" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Battalions}"
                          SelectedItem="{Binding SelectedBattalion}"
                          Background="#E5E5EA"
                          Foreground="#1C1C1E"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="대대 선택"
                          CornerRadius="8">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- 업체 검색 -->
              <StackPanel Spacing="6">
                <TextBlock Text="업체 검색" Foreground="#8E8E93" FontSize="12"/>

                <!-- 선택된 업체가 없을 때: 검색 입력 + 업체 추가 버튼 -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SelectedCompany, Converter={x:Static ObjectConverters.IsNull}}">
                  <TextBox Grid.Column="0" Text="{Binding CompanySearchText}"
                           Watermark="{Binding CompanySearchPlaceholder}"
                           Background="#E5E5EA"
                           Foreground="#1C1C1E"
                           Padding="12"
                           CornerRadius="8"
                           IsEnabled="{Binding SelectedDistrict, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                  <Button Grid.Column="1" Command="{Binding OpenCompanyListCommand}"
                          Background="#deb887" Padding="10,10" CornerRadius="8" Margin="6,0,0,0"
                          VerticalAlignment="Stretch"
                          IsEnabled="{Binding SelectedDistrict, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="&#xe145;" FontFamily="{StaticResource MaterialIcons}" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                      <TextBlock Text="목록" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>

                <!-- 선택된 업체가 있을 때: 선택된 업체 표시 -->
                <Border Background="#E5E5EA" CornerRadius="8" Padding="12"
                        IsVisible="{Binding SelectedCompany, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <TextBlock Text="{Binding SelectedCompany.Name}" FontSize="14" Foreground="#1C1C1E"/>
                      <TextBlock Text="{Binding SelectedCompany.Address}" FontSize="11" Foreground="#8E8E93"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ClearCompanySelectionCommand}"
                            Background="#C7C7CC" Padding="8,4" CornerRadius="6" VerticalAlignment="Center">
                      <TextBlock Text="&#xe5cd;" FontFamily="{StaticResource MaterialIcons}" FontSize="16" Foreground="#8E8E93"/>
                    </Button>
                  </Grid>
                </Border>

                <!-- 검색 결과 목록 -->
                <Border Background="#E5E5EA" CornerRadius="8" Padding="6"
                        IsVisible="{Binding ShowCompanySearchResults}"
                        MaxHeight="200">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SearchedCompanies}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Command="{Binding $parent[ItemsControl].((vm:ScheduleCreateViewModel)DataContext).SelectCompanyCommand}"
                                  CommandParameter="{Binding}"
                                  Background="Transparent"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Padding="10,8"
                                  Margin="0,2"
                                  CornerRadius="6">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#1C1C1E"/>
                              <TextBlock Text="{Binding Address}" FontSize="11" Foreground="#8E8E93"
                                         TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>

                <!-- 검색 안내 -->
                <TextBlock Text="2글자 이상 입력하면 해당 지역의 업체를 검색합니다."
                           FontSize="11" Foreground="#AEAEB2"
                           IsVisible="{Binding SelectedCompany, Converter={x:Static ObjectConverters.IsNull}}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 자동 연결 정보 -->
          <Border Background="#FFFFFF" CornerRadius="12" Padding="16"
                  IsVisible="{Binding ShowAutoInfo}">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#xe8f4;" FontFamily="{StaticResource MaterialIcons}" FontSize="16" Foreground="#8E8E93" VerticalAlignment="Center"/>
                <TextBlock Text="자동 연결 정보" FontSize="14" Foreground="#8E8E93" VerticalAlignment="Center"/>
              </StackPanel>

              <!-- 업체 정보 -->
              <StackPanel Spacing="6"
                          IsVisible="{Binding SelectedCompany, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="업체 정보" FontSize="12" Foreground="#AEAEB2"/>
                <TextBlock Text="{Binding CompanyAddress}" FontSize="13" Foreground="#00a872"
                           TextWrapping="Wrap"
                           IsVisible="{Binding CompanyAddress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="{Binding CompanyProducts}" FontSize="13" Foreground="#deb887"
                           TextWrapping="Wrap"
                           IsVisible="{Binding CompanyProducts, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>

              <!-- 지자체담당자 정보 -->
              <StackPanel Spacing="6"
                          IsVisible="{Binding SelectedDistrict, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="지자체담당자" FontSize="12" Foreground="#AEAEB2"/>
                <Panel>
                  <TextBlock Text="{Binding LocalUserName}" FontSize="13" Foreground="#488e72"
                             IsVisible="{Binding HasLocalUser}"/>
                  <TextBlock Text="{Binding LocalUserName}" FontSize="13" Foreground="#F44336"
                             IsVisible="{Binding !HasLocalUser}"/>
                </Panel>
              </StackPanel>

              <!-- 대대담당자 정보 -->
              <StackPanel Spacing="6"
                          IsVisible="{Binding SelectedBattalion, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="대대담당자" FontSize="12" Foreground="#AEAEB2"/>
                <Panel>
                  <TextBlock Text="{Binding MilitaryUserName}" FontSize="13" Foreground="#00a872"
                             IsVisible="{Binding HasMilitaryUser}"/>
                  <TextBlock Text="{Binding MilitaryUserName}" FontSize="13" Foreground="#F44336"
                             IsVisible="{Binding !HasMilitaryUser}"/>
                </Panel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 일정 생성 버튼 -->
          <Panel Margin="0,8,0,0">
            <Button Command="{Binding CreateScheduleCommand}"
                    Background="#deb887"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="16"
                    CornerRadius="10"
                    IsVisible="{Binding CanCreate}">
              <TextBlock Text="일정 생성" FontSize="15" Foreground="#FFFFFF"/>
            </Button>
            <Button Background="#C7C7CC"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="16"
                    CornerRadius="10"
                    IsEnabled="False"
                    IsVisible="{Binding !CanCreate}">
              <TextBlock Text="일정 생성" FontSize="15" Foreground="#AEAEB2"/>
            </Button>
          </Panel>

          <!-- 안내 문구 -->
          <TextBlock Text="일정이 생성되면 지자체담당자에게 알림이 발송됩니다."
                     FontSize="11" Foreground="#AEAEB2" HorizontalAlignment="Center"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- 업체 전체 목록 팝업 오버레이 -->
    <Grid IsVisible="{Binding ShowCompanyListPopup}">
      <!-- 반투명 배경 -->
      <Border Background="#80000000">
        <Button Command="{Binding CloseCompanyListCommand}" Background="Transparent"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </Border>

      <!-- 팝업 컨텐츠 -->
      <Border Background="#FFFFFF" CornerRadius="16" Margin="16,60,16,60"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
              BoxShadow="0 4 20 #40000000">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <!-- 팝업 헤더 -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,16,16,8">
            <TextBlock Grid.Column="0" Text="업체 전체 목록" FontSize="16" Foreground="#1C1C1E"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding TotalCompanyCount, StringFormat='({0}개)'}"
                       FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center" Margin="6,0,0,0"/>
            <Button Grid.Column="2" Command="{Binding CloseCompanyListCommand}"
                    Background="Transparent" Padding="8,4">
              <TextBlock Text="&#xe5cd;" FontFamily="{StaticResource MaterialIcons}" FontSize="20" Foreground="#8E8E93"/>
            </Button>
          </Grid>

          <!-- 매칭 상태 요약 -->
          <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="16,0,16,8">
            <Border Grid.Column="0" Background="#E8F5E9" CornerRadius="8" Padding="10,6" Margin="0,0,4,0">
              <TextBlock Foreground="#4CAF50" FontSize="12" HorizontalAlignment="Center">
                <TextBlock.Text>
                  <MultiBinding StringFormat="매칭 {0}개">
                    <Binding Path="MatchedCompanyCount"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Border>
            <Border Grid.Column="1" Background="#FFF3E0" CornerRadius="8" Padding="10,6" Margin="4,0,0,0">
              <TextBlock Foreground="#FF9800" FontSize="12" HorizontalAlignment="Center">
                <TextBlock.Text>
                  <MultiBinding StringFormat="미매칭 {0}개">
                    <Binding Path="UnmatchedCompanyCount"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Border>
          </Grid>

          <!-- 필터 버튼 -->
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="16,0,16,10">
            <!-- 전체 필터 -->
            <Panel>
              <Button Command="{Binding SetCompanyListFilterCommand}" CommandParameter="전체"
                      Padding="12,6" CornerRadius="14"
                      Background="#1C1C1E"
                      IsVisible="{Binding IsFilterAll}">
                <TextBlock Text="전체" FontSize="12" Foreground="#FFFFFF"/>
              </Button>
              <Button Command="{Binding SetCompanyListFilterCommand}" CommandParameter="전체"
                      Padding="12,6" CornerRadius="14"
                      Background="#E5E5EA"
                      IsVisible="{Binding !IsFilterAll}">
                <TextBlock Text="전체" FontSize="12" Foreground="#1C1C1E"/>
              </Button>
            </Panel>
            <!-- 매칭 필터 -->
            <Panel>
              <Button Command="{Binding SetCompanyListFilterCommand}" CommandParameter="매칭"
                      Padding="12,6" CornerRadius="14"
                      Background="#4CAF50"
                      IsVisible="{Binding IsFilterMatched}">
                <TextBlock Text="매칭" FontSize="12" Foreground="#FFFFFF"/>
              </Button>
              <Button Command="{Binding SetCompanyListFilterCommand}" CommandParameter="매칭"
                      Padding="12,6" CornerRadius="14"
                      Background="#E5E5EA"
                      IsVisible="{Binding !IsFilterMatched}">
                <TextBlock Text="매칭" FontSize="12" Foreground="#4CAF50"/>
              </Button>
            </Panel>
            <!-- 미매칭 필터 -->
            <Panel>
              <Button Command="{Binding SetCompanyListFilterCommand}" CommandParameter="미매칭"
                      Padding="12,6" CornerRadius="14"
                      Background="#FF9800"
                      IsVisible="{Binding IsFilterUnmatched}">
                <TextBlock Text="미매칭" FontSize="12" Foreground="#FFFFFF"/>
              </Button>
              <Button Command="{Binding SetCompanyListFilterCommand}" CommandParameter="미매칭"
                      Padding="12,6" CornerRadius="14"
                      Background="#E5E5EA"
                      IsVisible="{Binding !IsFilterUnmatched}">
                <TextBlock Text="미매칭" FontSize="12" Foreground="#FF9800"/>
              </Button>
            </Panel>
          </StackPanel>

          <!-- 업체 목록 -->
          <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" Margin="16,0,16,16">
            <ItemsControl ItemsSource="{Binding AllCompanyList}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding $parent[ItemsControl].((vm:ScheduleCreateViewModel)DataContext).SelectCompanyFromListCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Padding="12,10"
                          Margin="0,2"
                          CornerRadius="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="{Binding Company.Name}" FontSize="14" Foreground="#1C1C1E"/>
                        <TextBlock Text="{Binding Company.Address}" FontSize="11" Foreground="#8E8E93"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Company.Products}" FontSize="11" Foreground="#AEAEB2"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding Company.Products, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      </StackPanel>
                      <Border Grid.Column="1" CornerRadius="10" Padding="8,4"
                              VerticalAlignment="Center"
                              Background="{Binding MatchStatusColor}">
                        <TextBlock Text="{Binding MatchStatusText}" FontSize="11" Foreground="#FFFFFF"/>
                      </Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- 워터마크 (최상단 레이어, IsHitTestVisible=False로 터치 통과) -->
    <Image Source="{StaticResource Mark31WatermarkSvg}"
           Width="240" Height="280"
           HorizontalAlignment="Center" VerticalAlignment="Center"
           IsHitTestVisible="False"/>
  </Grid>
</UserControl>
